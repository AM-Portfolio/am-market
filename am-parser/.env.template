# Environment Configuration for AM Parser
# Copy to .env and fill in real values (never commit .env).
# In Kubernetes, MONGO_URI and TOGETHER_API_KEY come from Vault via Helm.

# Together AI Configuration
TOGETHER_API_KEY=

# Default Configuration
DEFAULT_PARSE_METHOD=together

# MongoDB Configuration
MONGO_URI=mongodb://admin:YOUR_MONGO_PASSWORD@localhost:27017/?authSource=admin
MONGO_DB=mutual_funds

# Downstream services
MARKET_DATA_URL=http://localhost:8093
ETF_LIST_CACHE_MINUTES=60
ETF_HOLDINGS_CACHE_DAYS=1

# Server Configuration
ENVIRONMENT=local
API_HOST=127.0.0.1
API_PORT=8001
LOG_LEVEL=INFO
