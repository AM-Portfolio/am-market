# Environment Configuration for AM Parser
# Copy to .env and fill in real values (never commit .env).
# Kubernetes: secrets from Vault (MONGO_URI, TOGETHER_API_KEY); non-secrets from Helm env.

ENVIRONMENT=local

# Together AI (local only — cluster uses Vault)
TOGETHER_API_KEY=your-together-api-key

# MongoDB (local only — cluster uses Vault MONGO_URI)
MONGO_URI=mongodb://admin:YOUR_MONGO_PASSWORD@localhost:27017/?authSource=admin
MONGO_DB=mutual_funds

# Downstream services (Helm sets MARKET_DATA_URL in dev/preprod/prod)
MARKET_DATA_URL=http://localhost:8093

# Parser behaviour
DEFAULT_PARSE_METHOD=together
ETF_LIST_CACHE_MINUTES=60
ETF_HOLDINGS_CACHE_DAYS=1
LOG_LEVEL=INFO

# Server (local uvicorn)
API_HOST=127.0.0.1
API_PORT=8001
