          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"items\": [\"{{symbol}}\"]\n}"
            },
            "url": "{{parserBaseUrl}}/v2/funds/performance/refresh"
          }
        }
      ]
    },
