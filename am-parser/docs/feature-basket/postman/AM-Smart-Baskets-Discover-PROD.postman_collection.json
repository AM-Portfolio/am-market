        {
          "name": "B3 Basket opportunities (Discover)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 200', () => pm.response.to.have.status(200));",
                  "const j = pm.response.json();",
                  "const rows = Array.isArray(j) ? j : (j.opportunities || j.data || []);",
                  "pm.test('rows non-empty', () => pm.expect(rows).to.be.an('array').that.is.not.empty);",
                  "const r = rows[0];",
                  "pm.test('etfSymbol present', () => pm.expect(r.etfSymbol).to.be.a('string').and.not.empty);",
                  "pm.test('categoryLabel present', () => pm.expect(r.categoryLabel).to.be.a('string').and.not.empty);",
                  "pm.test('matchScore present', () => pm.expect(r).to.have.property('matchScore'));",
                  "pm.test('return1Y number or null (never fake missing as required)', () => {",
                  "  pm.expect(r.return1Y === null || typeof r.return1Y === 'number').to.be.true;",
                  "});",
                  "pm.test('PROD expect live discover enrichment', () => {",
                  "  pm.expect(r.return1Y).to.be.a('number');",
                  "  pm.expect(r.sparklineCloses).to.be.an('array').with.lengthOf.at.least(2);",
