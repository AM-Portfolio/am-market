    {
      "name": "MF Catalog (NSE MASTER_DOWNLOAD)",
      "description": "EOD scheme catalog + NAV from Postgres mf_catalog (writer = mf_catalog_job from NSE MASTER_DOWNLOAD). Prefer these for Explore / NAV.",
      "item": [
        {
          "name": "Search schemes",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/v1/mutual-fund/search?q=HDFC&limit=5",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "v1",
                "mutual-fund",
                "search"
              ],
              "query": [
                {
                  "key": "q",
                  "value": "HDFC"
                },
                {
                  "key": "limit",
                  "value": "5"
                }
              ]
            },
            "description": "Search MF schemes by name/code/ISIN. Returns EOD NAV, purchaseAllowed, source=nse-master-download."
          },
          "response": []
        },
        {
          "name": "NAV batch (portfolio)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/v1/mutual-fund/nav/batch",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "v1",
                "mutual-fund",
                "nav",
                "batch"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"isins\": [\n    \"INF179K01400\",\n    \"INF247L01999\"\n  ]\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "description": "Bulk latest + previousNav for portfolio MF books. One mark per ISIN (max 200). source=nse-master-download."
          },
          "response": []
        },
        {
          "name": "Scheme details",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/v1/mutual-fund/{{schemeId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "v1",
                "mutual-fund",
                "{{schemeId}}"
              ]
            },
            "description": "Single scheme card: metadata + latest NAV for schemeId (NSE scheme code)."
          },
          "response": []
        },
        {
          "name": "Scheme history",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/v1/mutual-fund/{{schemeId}}/history?from=2025-01-01&to=2025-12-31",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "v1",
                "mutual-fund",
                "{{schemeId}}",
                "history"
              ],
              "query": [
                {
                  "key": "from",
                  "value": "2025-01-01"
                },
                {
                  "key": "to",
                  "value": "2025-12-31"
                }
              ]
            },
            "description": "NAV time series between from/to dates (query: from, to as YYYY-MM-DD)."
          },
          "response": []
        },
        {
          "name": "Scheme performance",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/v1/mutual-fund/{{schemeId}}/performance",
