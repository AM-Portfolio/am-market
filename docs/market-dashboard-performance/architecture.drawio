        <mxCell id="mp-cache" value="analysis:history\n&lt;symbol&gt;:&lt;years&gt;:false" style="shape=cylinder;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;" vertex="1" parent="mp1"><mxGeometry x="560" y="30" width="220" height="80" as="geometry"/></mxCell>
        <mxCell id="mp-raw" value="Raw historical retrieval\nRedis → Influx → Upstox" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;" vertex="1" parent="mp1"><mxGeometry x="560" y="150" width="220" height="80" as="geometry"/></mxCell>
        <mxCell id="mp-result" value="Monthly aggregation\n120 months / 2,448 points" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;" vertex="1" parent="mp1"><mxGeometry x="860" y="150" width="220" height="80" as="geometry"/></mxCell>
        <mxCell id="mp-scheduler" value="Market-calendar scheduler\nafter-close refresh" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#666666;" vertex="1" parent="mp1"><mxGeometry x="860" y="30" width="220" height="80" as="geometry"/></mxCell>
        <mxCell id="mpe1" style="edgeStyle=orthogonalEdgeStyle;endArrow=block;strokeColor=#6C8EBF;" edge="1" parent="mp1" source="mp-client" target="mp-api"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="mpe2" value="exact UI key" style="edgeStyle=orthogonalEdgeStyle;endArrow=block;strokeColor=#82B366;" edge="1" parent="mp1" source="mp-api" target="mp-cache"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="mpe3" value="miss: bounded refresh" style="edgeStyle=orthogonalEdgeStyle;endArrow=block;strokeColor=#D6B656;" edge="1" parent="mp1" source="mp-api" target="mp-raw"><mxGeometry relative="1" as="geometry"/></mxCell>
