        <mxCell id="mpe5" value="atomic replace / monthly merge" style="edgeStyle=orthogonalEdgeStyle;endArrow=block;strokeColor=#82B366;" edge="1" parent="mp1" source="mp-result" target="mp-cache"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="mpe6" value="market-day refresh" style="edgeStyle=orthogonalEdgeStyle;endArrow=block;strokeColor=#666666;dashed=1;" edge="1" parent="mp1" source="mp-scheduler" target="mp-cache"><mxGeometry relative="1" as="geometry"/></mxCell>
