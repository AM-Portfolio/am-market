{
  "info": {
    "_postman_id": "c8f29402-911e-4509-a16f-bc3a18921a99",
    "name": "Custom Watchlists API",
    "description": "Postman collection for multi-watchlist management in AM Portfolio Market Data, covering custom watchlists, 5-list limits, 50-stock capacities, stock containment checks, and CRUD operations.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "1. Get User Watchlists (Auto-Seeds Default)",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          },
          {
            "key": "X-User-Id",
            "value": "{{userId}}"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          },
          {
            "key": "User-Agent",
            "value": "PostmanRuntime/7.39.0"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/v1/watchlists",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "v1",
            "watchlists"
          ]
        }
      },
      "response": []
    },
    {
