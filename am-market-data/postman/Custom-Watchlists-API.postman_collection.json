          },
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          },
          {
            "key": "User-Agent",
            "value": "PostmanRuntime/7.39.0"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"IT Giants\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/v1/watchlists",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "v1",
            "watchlists"
          ]
        }
      },
      "response": []
