              ],
              "path": [
                "v1",
                "market-data",
                "historical-data"
              ]
            },
            "description": "Retrieves historical price and volume data points for a specific date range."
          },
          "response": []
        },
        {
          "name": "Get Mutual Fund Details",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/v1/market-data/mutual-fund/102868?refresh=false",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "v1",
                "market-data",
