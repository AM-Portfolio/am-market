            "url": {
              "raw": "{{baseUrl}}/v1/market-data/mutual-fund/102868/history?from=2026-01-01&to=2026-05-27&refresh=false",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "v1",
                "market-data",
                "mutual-fund",
                "102868",
                "history"
              ],
              "query": [
                {
                  "key": "from",
                  "value": "2026-01-01"
                },
                {
                  "key": "to",
                  "value": "2026-05-27"
                },
