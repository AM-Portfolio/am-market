                  "key": "refresh",
                  "value": "false"
                }
              ]
            },
            "description": "Retrieves historical NAV data points for the specified scheme code."
          },
          "response": []
        }
      ]
    },
    {
      "name": "Indices & Instruments",
      "item": [
        {
          "name": "Get Available Indices",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/v1/indices/available",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "v1",
                "indices",
                "available"
              ]
            },
            "description": "Retrieves the list of broad market and sector indices available on the NSE."
          },
          "response": []
        },
        {
          "name": "Get Latest Batch Indices Data",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "[\n  \"NIFTY 50\",\n  \"NIFTY BANK\",\n  \"NIFTY IT\"\n]"
            },
            "url": {
              "raw": "{{baseUrl}}/v1/indices/batch?forceRefresh=false",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "v1",
                "indices",
                "batch"
              ],
              "query": [
                {
                  "key": "forceRefresh",
                  "value": "false"
                }
              ]
            },
            "description": "Gets real-time batch index values for a list of Index names."
          },
          "response": []
        },
        {
          "name": "Search Instruments",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"queries\": [\"INFY\"],\n  \"exchanges\": [\"NSE\"],\n  \"instrumentTypes\": [\"EQUITY\"],\n  \"provider\": \"UPSTOX\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/v1/instruments/search",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "v1",
                "instruments",
                "search"
              ]
            },
            "description": "Performs filtered and semantic search across trading instruments database."
          },
          "response": []
        },
        {
          "name": "Update Instruments database from File",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/v1/instruments/update?provider=UPSTOX",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "v1",
                "instruments",
                "update"
              ],
              "query": [
                {
                  "key": "provider",
                  "value": "UPSTOX"
                },
                {
                  "key": "filePath",
                  "value": "data/upstock/instrument/NSE.json",
                  "disabled": true
                }
              ]
            },
            "description": "Triggers database update of instruments using local JSON files."
          },
          "response": []
        },
