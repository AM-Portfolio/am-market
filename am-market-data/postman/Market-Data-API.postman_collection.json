              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"symbols\": \"INFY\",\n  \"interval\": \"day\",\n  \"from\": \"2026-01-01\",\n  \"to\": \"2026-05-27\",\n  \"forceRefresh\": false\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/v1/market-data/historical-data",
