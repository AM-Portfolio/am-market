    {
      "name": "Streaming Management",
      "item": [
        {
          "name": "Connect Stream",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"instrumentKeys\": [\"INFY\", \"RELIANCE\"],\n  \"mode\": \"FULL\",\n  \"timeFrame\": \"1D\",\n  \"isIndexSymbol\": false,\n  \"stream\": true,\n  \"provider\": \"UPSTOX\",\n  \"forcePolling\": false\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/v1/market-data/stream/connect",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "v1",
                "market-data",
                "stream",
                "connect"
              ]
            },
            "description": "Initiates a WebSocket stream for the given instruments."
          },
          "response": []
        },
        {
          "name": "Initiate Stream (Structured)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"instrumentKeys\": [\"INFY\"],\n  \"mode\": \"FULL\",\n  \"timeFrame\": \"1D\",\n  \"isIndexSymbol\": false,\n  \"stream\": true,\n  \"provider\": \"UPSTOX\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/v1/market-data/stream/initiate",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "v1",
                "market-data",
                "stream",
                "initiate"
              ]
            },
            "description": "Initiates streaming and returns a structured response object with initial values."
          },
          "response": []
        },
        {
          "name": "Disconnect Stream",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/v1/market-data/stream/disconnect?provider=UPSTOX",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "v1",
                "market-data",
                "stream",
                "disconnect"
              ],
              "query": [
                {
                  "key": "provider",
                  "value": "UPSTOX"
                }
              ]
            },
            "description": "Closes the active WebSocket streaming channel for the specified provider."
          },
          "response": []
        }
      ]
    },
    {
      "name": "Market Analysis",
      "item": [
        {
          "name": "Get Top Movers & Gainers",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/v1/analysis/movers?type=gainers&limit=10&indexSymbol=NIFTY 50&expandIndices=false",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "v1",
                "analysis",
                "movers"
              ],
              "query": [
                {
                  "key": "type",
                  "value": "gainers",
                  "description": "Type: gainers, losers, or all"
                },
                {
                  "key": "limit",
                  "value": "10",
                  "description": "Number of results to return"
                },
                {
                  "key": "indexSymbol",
                  "value": "NIFTY 50",
                  "description": "Index symbol (e.g. NIFTY 50, NIFTY BANK)"
                },
                {
                  "key": "timeFrame",
                  "value": "1D",
                  "description": "Timeframe for analysis",
                  "disabled": true
                },
                {
                  "key": "expandIndices",
                  "value": "false",
                  "description": "Whether to expand index details"
                }
              ]
            },
            "description": "Retrieves top performing or worst performing stocks from the specified market index."
          },
          "response": []
        }
      ]
    }
