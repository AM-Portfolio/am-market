{
  "info": {
    "_postman_id": "c6a282f1-6789-4d32-8df2-ff2ea67f5b9d",
    "name": "Market Data API",
    "description": "Comprehensive Postman collection for testing the AM Portfolio Market Data API, including authentication, quotes, historical data, instruments, indices, and streaming connection management.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Authentication & Sessions",
      "item": [
        {
          "name": "Get Login URL",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/v1/market-data/auth/login-url?provider=UPSTOX",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "v1",
                "market-data",
                "auth",
                "login-url"
              ],
              "query": [
                {
                  "key": "provider",
                  "value": "UPSTOX",
                  "description": "Broker provider (e.g. UPSTOX, ZERODHA)"
                }
              ]
            },
            "description": "Generates and returns the broker login URL for user authentication."
          },
          "response": []
        },
        {
          "name": "Generate Session",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/v1/market-data/auth/session?request_token=YOUR_TOKEN_HERE&status=success",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "v1",
                "market-data",
                "auth",
                "session"
              ],
              "query": [
                {
                  "key": "request_token",
                  "value": "YOUR_TOKEN_HERE",
                  "description": "Request token returned from broker redirection"
                },
                {
                  "key": "status",
                  "value": "success"
                }
              ]
            },
            "description": "Creates an authenticated session using the authorization token returned from broker redirect."
          },
          "response": []
        },
        {
          "name": "Logout Session",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/v1/market-data/auth/logout",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "v1",
                "market-data",
                "auth",
                "logout"
              ]
            },
            "description": "Terminates the active broker session and clears access tokens."
          },
          "response": []
        }
      ]
    },
    {
      "name": "Market Data & Quotes",
      "item": [
        {
          "name": "Get Quotes (GET)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/v1/market-data/quotes?symbols=INFY,RELIANCE&timeFrame=5m&refresh=false",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "v1",
                "market-data",
                "quotes"
              ],
              "query": [
                {
                  "key": "symbols",
                  "value": "INFY,RELIANCE",
                  "description": "Comma-separated list of instrument keys/symbols"
                },
                {
                  "key": "timeFrame",
                  "value": "5m",
                  "description": "Timeframe (e.g. 5m, 15m, 1H, 1D)"
                },
                {
                  "key": "refresh",
                  "value": "false",
                  "description": "Force live refresh from broker"
                }
              ]
            },
            "description": "Fetches current quotes for multiple symbols."
          },
          "response": []
        },
        {
          "name": "Get Quotes (POST)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"symbols\": \"INFY,RELIANCE\",\n  \"timeFrame\": \"1D\",\n  \"indexSymbol\": false,\n  \"forceRefresh\": false\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/v1/market-data/quotes",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "v1",
                "market-data",
                "quotes"
              ]
            },
            "description": "POST version to retrieve quotes for a batch of symbols."
          },
          "response": []
        },
        {
          "name": "Get OHLC Data",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"symbols\": \"INFY,RELIANCE\",\n  \"timeFrame\": \"1D\",\n  \"indexSymbol\": false,\n  \"forceRefresh\": false\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/v1/market-data/ohlc",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "v1",
                "market-data",
                "ohlc"
              ]
            },
            "description": "Gets Open-High-Low-Close data for multiple instruments."
          },
          "response": []
        },
        {
          "name": "Get Live Prices",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/v1/market-data/live-prices?symbols=INFY,RELIANCE&isIndexSymbol=false&refresh=false",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "v1",
                "market-data",
                "live-prices"
              ],
              "query": [
                {
                  "key": "symbols",
                  "value": "INFY,RELIANCE"
                },
                {
                  "key": "isIndexSymbol",
                  "value": "false"
                },
                {
                  "key": "refresh",
                  "value": "false"
                }
              ]
            },
            "description": "Fetches current live price updates for active symbols."
          },
          "response": []
        },
        {
          "name": "Get Live LTP with Change",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/v1/market-data/live-ltp?symbols=INFY,RELIANCE&timeframe=1D&isIndexSymbol=false&refresh=false",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "v1",
                "market-data",
                "live-ltp"
              ],
              "query": [
                {
                  "key": "symbols",
                  "value": "INFY,RELIANCE"
                },
                {
                  "key": "timeframe",
                  "value": "1D"
                },
                {
                  "key": "isIndexSymbol",
                  "value": "false"
                },
                {
                  "key": "refresh",
                  "value": "false"
                }
              ]
            },
            "description": "Gets current LTP and calculates absolute and percentage changes based on previous close."
          },
          "response": []
        },
        {
          "name": "Get Option Chain",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/v1/market-data/option-chain?symbol=INFY&refresh=false",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "v1",
                "market-data",
                "option-chain"
              ],
              "query": [
                {
                  "key": "symbol",
                  "value": "INFY",
                  "description": "Underlying instrument symbol key"
                },
                {
                  "key": "expiryDate",
                  "value": "2026-06-25",
                  "description": "Optional expiry date in yyyy-MM-dd format",
                  "disabled": true
                },
                {
                  "key": "refresh",
                  "value": "false"
                }
              ]
            },
            "description": "Retrieves the call and put option chain for a given underlying symbol."
          },
          "response": []
        }
      ]
    },
    {
      "name": "Historical & Mutual Funds",
