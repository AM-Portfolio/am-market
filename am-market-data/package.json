{
  "name": "am-market-data",
  "version": "1.0.0",
  "description": "Market Data Service — local run orchestration",
  "scripts": {
    "preprod:compile": "mvn -pl market-data-app -am install -DskipTests -B",
    "preprod:start": "npx -y dotenv-cli -e .env.preprod -- mvn -f market-data-app/pom.xml spring-boot:run",
    "run:preprod": "npm run preprod:compile && npm run preprod:start",
    "dev:compile": "mvn -pl market-data-app -am install -DskipTests -B",
    "dev:start": "npx -y dotenv-cli -e .env.dev -- mvn -f market-data-app/pom.xml spring-boot:run",
    "run:dev": "npm run dev:compile && npm run dev:start",
    "env:from-vault": "python scripts/map_env_from_vault_backup.py",
    "env:preprod": "python scripts/map_env_from_vault_backup.py --env preprod",
    "env:dev": "python scripts/map_env_from_vault_backup.py --env dev"
  }
}
