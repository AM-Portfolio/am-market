# AM Market Data — placeholders only (committed). Copy to gitignored env files:
#   copy .env.template .env.preprod   →  npm run run:preprod
#   copy .env.template .env.dev       →  npm run run:dev
# Or: npm run env:preprod | npm run env:dev
# See ENV.md for full workflow (Vault backup → dotenv-cli → port 8092).

SPRING_PROFILES_ACTIVE=preprod
SERVER_PORT=8092

# GitHub Package Registry
GITHUB_PACKAGES_USERNAME=
GITHUB_PACKAGES_TOKEN=

# PostgreSQL
POSTGRES_PASSWORD=
POSTGRES_USERNAME=postgres
POSTGRES_URL=jdbc:postgresql://localhost:5432
POSTGRES_DATABASE=portfolio

MONGODB_URL=mongodb://${MONGODB_USERNAME}:${MONGODB_PASSWORD}@localhost:27017/market_data?authSource=admin
MONGODB_DATABASE=market_data
MONGODB_USERNAME=admin
MONGODB_PASSWORD=

# InfluxDB
INFLUXDB_TOKEN=
INFLUXDB_ORG=am-portfolio
INFLUXDB_BUCKET=market-data
INFLUXDB_URL=http://localhost:8086

# Grafana
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=
GRAFANA_ADMIN_TOKEN=

# Redis
REDIS_HOSTNAME=localhost
REDIS_PASSWORD=
REDIS_PORT=6379

# Kafka
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_ZOOKEEPER_CONNECT=localhost:2181
KAFKA_ADVERTISED_LISTENERS=SASL_PLAINTEXT://localhost:9092
KAFKA_LISTENER_SECURITY_PROTOCOL_MAP=SASL_PLAINTEXT:SASL_PLAINTEXT
KAFKA_INTER_BROKER_LISTENER_NAME=SASL_PLAINTEXT
KAFKA_CONSUMER_GROUP_ID=am-market-data-service
KAFKA_CONSUMER_AUTO_OFFSET_RESET=earliest

# Kafka Auth
KAFKA_USERNAME=kafkaUser
KAFKA_PASSWORD=

# Batch-search (local; Helm uses config.batchSearch.cacheEnabled per env)
BATCH_SEARCH_CACHE_ENABLED=true
BATCH_SEARCH_MONGO_QUERY_LIMIT=0
BATCH_SEARCH_MAX_CANDIDATES=100
BATCH_SEARCH_INTERNAL_BATCH_SIZE=100

# Application
STOKUPATE_TOPIC_NAME=am-stock-price-update
NSE_INDICES_TOPIC_NAME=nse-indices-update
NSE_ETF_TOPIC_NAME=nse-etf-update
MARKET_DATA_MAX_RETRIES=3
MARKET_DATA_RETRY_DELAY_MS=1000
MARKET_DATA_THREAD_POOL_SIZE=5
MARKET_DATA_THREAD_QUEUE_CAPACITY=10
MARKET_DATA_MAX_AGE_MINUTES=15

# Upstox
UPSTOX_ACCESS_TOKEN=
UPSTOX_API_KEY=
UPSTOX_SECRET_KEY=
UPSTOX_CODE=

# Zerodha API Configuration
ZERODHA_API_KEY=
ZERODHA_API_SECRET=
ZERODHA_API_MAX_RETRIES=3
ZERODHA_API_RETRY_DELAY_MS=1000
ZERODHA_API_RETRY_MAX_DURATION_MS=10000
ZERODHA_API_THREAD_POOL_SIZE=5
ZERODHA_API_THREAD_QUEUE_CAPACITY=10
ZERODHA_API_ACCESS_TOKEN=
ZERODHA_API_REFRESH_TOKEN=

# Ticker Configuration
ZERODHA_TICKER_ENABLED=false
ZERODHA_TICKER_RECONNECT_MAX_RETRIES=10
ZERODHA_TICKER_RECONNECT_INTERVAL=30

# Scheduler: daily historical at 07:15; live prices via Upstox WebSocket (not REST poll)
SCHEDULER_INGESTION_ENABLED=true
SCHEDULER_INGESTION_PROVIDER=UPSTOX
SCHEDULER_INGESTION_FORCE=false
SCHEDULER_INGESTION_USE_WEBSOCKET=true
SCHEDULER_INGESTION_POLL_ENABLED=false
SCHEDULER_INGESTION_POLL_HISTORICAL=false

# Market Data Configuration
ZERODHA_MARKET_DATA_ENABLED=true
ZERODHA_MARKET_HOURS_START=00:00
ZERODHA_MARKET_HOURS_END=23:59
ZERODHA_MARKET_TIMEZONE=Asia/Kolkata
ZERODHA_NSE_INSTRUMENTS=NSE:NIFTY 50,NSE:BANKNIFTY,NSE:FINNIFTY
ZERODHA_BSE_INSTRUMENTS=BSE:SENSEX,BSE:BANKEX
ZERODHA_INDEX_INSTRUMENTS=NSE:NIFTY 50,NSE:BANKNIFTY,NSE:FINNIFTY,BSE:SENSEX

# JWT Configuration
INTERNAL_JWT_SECRET=
JWT_SECRET=
JWT_ALGORITHM=HS256
